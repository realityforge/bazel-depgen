load("@buildifier_prebuilt//:rules.bzl", "buildifier")
load("@rules_palantir_java_format//:defs.bzl", "java_format_check")

package(default_visibility = ["//visibility:public"])

WARNINGS = [
    "+unsorted-dict-items",
    "-module-docstring",
    "-function-docstring",
]

buildifier(
    name = "buildifier",
    exclude_patterns = [
        "./.git/*",
        "./.bazelbsp/*",
    ],
    lint_mode = "fix",
    lint_warnings = WARNINGS,
)

buildifier(
    name = "buildifier_check",
    diff_command = "diff -u",
    exclude_patterns = [
        "./.git/*",
        "./.bazelbsp/*",
    ],
    lint_mode = "warn",
    lint_warnings = WARNINGS,
    mode = "diff",
)

test_suite(
    name = "all_tests",
    tests = [
        "//src/test/java/org/realityforge/bazel/depgen:all_tests",
        "//tools/release:all_tests",
    ],
)

java_format_check(
    name = "java_format_check",
    testonly = True,
    remediation = "tools/java_format.sh write",
    targets = [
        ":all_tests",
        "//src/main/java/org/realityforge/bazel/depgen:bazel_depgen",
        "//tools/release/org/realityforge/bazel/depgen/release:dist",
        "//tools/release/org/realityforge/bazel/depgen/release:jar_builder",
        "//tools/release/org/realityforge/bazel/depgen/release:javadoc_jar_builder",
        "//tools/release/org/realityforge/bazel/depgen/release:release_lifecycle",
    ],
)
