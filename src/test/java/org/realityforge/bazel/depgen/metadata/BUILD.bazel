load("//third_party/java:rules.bzl", "java_testng_test")

package(default_visibility = ["//visibility:public"])

DEPS = [
    "//src/main/java/org/realityforge/bazel/depgen",
    "//src/test/java/org/realityforge/bazel/depgen:test_support",
    "//third_party/java:gir_core",
    "//third_party/java:guiceyloops",
    "//third_party/java:maven_resolver_api",
    "//third_party/java:testng",
]

java_testng_test(
    name = "depgen_metadata_tests",
    size = "small",
    srcs = [
        "DepgenMetadataTest.java",
        "package-info.java",
    ],
    test_classes = [
        "org.realityforge.bazel.depgen.metadata.DepgenMetadataTest",
    ],
    deps = DEPS,
)

java_testng_test(
    name = "record_util_tests",
    size = "small",
    srcs = [
        "RecordUtilTest.java",
        "package-info.java",
    ],
    test_classes = [
        "org.realityforge.bazel.depgen.metadata.RecordUtilTest",
    ],
    deps = DEPS,
)

test_suite(
    name = "all_tests",
    tests = [
        ":depgen_metadata_tests",
        ":record_util_tests",
    ],
)
