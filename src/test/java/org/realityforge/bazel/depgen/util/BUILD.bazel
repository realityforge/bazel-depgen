load("//third_party/java:rules.bzl", "java_testng_test")

package(default_visibility = ["//visibility:public"])

java_testng_test(
    name = "unit_tests",
    size = "small",
    srcs = [
        "ArtifactUtilTest.java",
        "GeneratedSectionWriterTest.java",
        "HashUtilTest.java",
        "OrderedPropertiesTest.java",
        "StarlarkOutputTest.java",
        "YamlUtilTest.java",
        "package-info.java",
    ],
    test_classes = [
        "org.realityforge.bazel.depgen.util.ArtifactUtilTest",
        "org.realityforge.bazel.depgen.util.GeneratedSectionWriterTest",
        "org.realityforge.bazel.depgen.util.HashUtilTest",
        "org.realityforge.bazel.depgen.util.OrderedPropertiesTest",
        "org.realityforge.bazel.depgen.util.StarlarkOutputTest",
        "org.realityforge.bazel.depgen.util.YamlUtilTest",
    ],
    deps = [
        "//src/main/java/org/realityforge/bazel/depgen",
        "//src/main/java/org/realityforge/bazel/depgen/util:ordered_properties",
        "//src/test/java/org/realityforge/bazel/depgen:test_support",
        "//third_party/java:gir_core",
        "//third_party/java:maven_resolver_api",
        "//third_party/java:testng",
    ],
)

java_testng_test(
    name = "bazel_util_integration_test",
    size = "medium",
    srcs = [
        "BazelUtilTest.java",
        "package-info.java",
    ],
    test_classes = [
        "org.realityforge.bazel.depgen.util.BazelUtilTest",
    ],
    deps = [
        "//src/main/java/org/realityforge/bazel/depgen",
        "//src/main/java/org/realityforge/bazel/depgen/util:ordered_properties",
        "//src/test/java/org/realityforge/bazel/depgen:test_support",
        "//third_party/java:gir_core",
        "//third_party/java:maven_resolver_api",
        "//third_party/java:testng",
    ],
)

test_suite(
    name = "all_tests",
    tests = [
        ":bazel_util_integration_test",
        ":unit_tests",
    ],
)
