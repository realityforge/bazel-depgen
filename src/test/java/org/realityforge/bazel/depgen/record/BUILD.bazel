load("//third_party/java:rules.bzl", "java_testng_test")

package(default_visibility = ["//visibility:public"])

DEPS = [
    "//src/main/java/org/realityforge/bazel/depgen",
    "//src/test/java/org/realityforge/bazel/depgen:test_support",
    "//third_party/java:gir_core",
    "//third_party/java:maven_resolver_api",
    "//third_party/java:testng",
]

java_testng_test(
    name = "application_record_tests",
    size = "small",
    srcs = [
        "ApplicationRecordTest.java",
        "package-info.java",
    ],
    test_classes = [
        "org.realityforge.bazel.depgen.record.ApplicationRecordTest",
    ],
    deps = DEPS,
)

java_testng_test(
    name = "artifact_record_tests",
    size = "small",
    srcs = [
        "ArtifactRecordTest.java",
        "package-info.java",
    ],
    test_classes = [
        "org.realityforge.bazel.depgen.record.ArtifactRecordTest",
    ],
    deps = DEPS,
)

test_suite(
    name = "all_tests",
    tests = [
        ":application_record_tests",
        ":artifact_record_tests",
    ],
)
