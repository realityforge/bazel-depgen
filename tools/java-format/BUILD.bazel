load("@rules_java//java:defs.bzl", "java_import")
load("//third_party/java:rules.bzl", "java_binary")

package(default_visibility = ["//visibility:public"])

java_import(
    name = "error_prone_annotations",
    jars = ["@palantir_java_format_error_prone_annotations//file"],
)

java_import(
    name = "failureaccess",
    jars = ["@palantir_java_format_failureaccess//file"],
)

java_import(
    name = "j2objc_annotations",
    jars = ["@palantir_java_format_j2objc_annotations//file"],
)

java_import(
    name = "jspecify",
    jars = ["@palantir_java_format_jspecify//file"],
)

java_import(
    name = "listenablefuture",
    jars = ["@palantir_java_format_listenablefuture//file"],
)

java_import(
    name = "guava",
    jars = ["@palantir_java_format_guava//file"],
    deps = [
        ":error_prone_annotations",
        ":failureaccess",
        ":j2objc_annotations",
        ":jspecify",
        ":listenablefuture",
    ],
)

java_import(
    name = "functionaljava",
    jars = ["@functionaljava//file"],
)

java_import(
    name = "jackson_annotations",
    jars = ["@jackson_annotations//file"],
)

java_import(
    name = "jackson_core",
    jars = ["@jackson_core//file"],
)

java_import(
    name = "jackson_databind",
    jars = ["@jackson_databind//file"],
    deps = [
        ":jackson_annotations",
        ":jackson_core",
    ],
)

java_import(
    name = "jackson_datatype_guava",
    jars = ["@jackson_datatype_guava//file"],
    deps = [
        ":guava",
        ":jackson_annotations",
        ":jackson_core",
        ":jackson_databind",
    ],
)

java_import(
    name = "jackson_datatype_jdk8",
    jars = ["@jackson_datatype_jdk8//file"],
    runtime_deps = [
        ":jackson_core",
        ":jackson_databind",
    ],
)

java_import(
    name = "jackson_module_parameter_names",
    jars = ["@jackson_module_parameter_names//file"],
    runtime_deps = [
        ":jackson_core",
        ":jackson_databind",
    ],
)

java_import(
    name = "jsr305",
    jars = ["@jsr305//file"],
)

java_import(
    name = "palantir_java_format_spi",
    jars = ["@palantir_java_format_spi//file"],
    deps = [
        ":guava",
        ":jackson_annotations",
        ":jackson_datatype_guava",
    ],
)

java_import(
    name = "palantir_java_format_lib",
    jars = ["@palantir_java_format//file"],
    runtime_deps = [
        ":functionaljava",
        ":jackson_datatype_jdk8",
        ":jackson_module_parameter_names",
        ":jsr305",
    ],
    deps = [
        ":guava",
        ":jackson_core",
        ":jackson_databind",
        ":palantir_java_format_spi",
    ],
)

java_binary(
    name = "palantir_java_format",
    jvm_flags = [
        "--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED",
        "--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED",
        "--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED",
        "--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED",
        "--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED",
        "--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED",
    ],
    main_class = "com.palantir.javaformat.java.Main",
    runtime_deps = [
        ":palantir_java_format_lib",
    ],
)
